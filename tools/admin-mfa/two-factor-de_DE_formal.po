#. translators: 1: failed verification attempts, 2: time since last attempt.
#: two-factor/class-two-factor-core.php:1158
#, php-format
msgid "%1$s failed verification code attempt on this account. The last attempt was %2$s ago. If you did not make this attempt, someone else may know your password. Change your password after you log in."
msgid_plural "%1$s failed verification code attempts on this account. The last attempt was %2$s ago. If you did not make these attempts, someone else may know your password. Change your password after you log in."
msgstr[0] "%1$s fehlgeschlagener Verifizierungsversuch für dieses Konto. Der letzte Versuch liegt %2$s zurück. Falls dieser Versuch nicht von Ihnen stammt, kennt möglicherweise jemand Ihr Passwort. Ändern Sie Ihr Passwort nach der Anmeldung."
msgstr[1] "%1$s fehlgeschlagene Verifizierungsversuche für dieses Konto. Der letzte Versuch liegt %2$s zurück. Falls diese Versuche nicht von Ihnen stammen, kennt möglicherweise jemand Ihr Passwort. Ändern Sie Ihr Passwort nach der Anmeldung."
