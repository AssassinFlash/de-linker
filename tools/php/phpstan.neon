# Shared PHPStan settings of the Linker PHP projects (the plugins and
# tools/local; the plugins add phpstan-plugins.neon). %rootDir% is the
# vendor/phpstan/phpstan of the project being analysed, so each project reads
# the stubs from its own vendor/. The PHP version (8.3) comes from that
# project's composer.json config.platform.php.
includes:
	- %rootDir%/../../szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Level 8 for all code (AGENTS.md §4; WooCommerce core runs level 8,
	# docs/research/2026-10-09/framework-choice.md §6).
	level: 8
