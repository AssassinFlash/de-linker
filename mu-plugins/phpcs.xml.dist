<?xml version="1.0"?>
<ruleset name="Linker mu-plugins">
	<description>The production must-use plugins: the shared plugin rules (tools/php/phpcs.xml) with this project's prefixes.</description>

	<file>linker-error-recorder.php</file>
	<file>linker-engine-pin.php</file>
	<file>linker-site-guards.php</file>
	<file>linker-deploy-reset.php</file>
	<file>linker-publication-worker-access.php</file>
	<file>linker-inventory-access.php</file>
	<file>tests</file>

	<rule ref="../tools/php/phpcs.xml"/>

	<!--
		The deployment name of a must-use plugin is the plugin: one file named
		after its purpose, not after the class in it.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>linker-error-recorder.php</exclude-pattern>
		<exclude-pattern>linker-deploy-reset.php</exclude-pattern>
		<exclude-pattern>linker-publication-worker-access.php</exclude-pattern>
		<exclude-pattern>linker-inventory-access.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Linker\Mu"/>
				<element value="linker_error"/>
				<element value="linker_site_guards"/>
				<element value="linker_publication_fixture"/>
				<element value="linker_inventory"/>
			</property>
		</properties>
	</rule>
</ruleset>
