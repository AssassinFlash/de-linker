# Editor settings: WordPress coding standards for PHP, JS and CSS (tabs);
# PEP 8 for Python.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_style = space
indent_size = 4

[{justfile,*.just}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
