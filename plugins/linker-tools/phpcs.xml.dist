<?xml version="1.0"?>
<ruleset name="Linker Tools">
	<description>Linker Tools: the shared plugin rules (tools/php/phpcs.xml) with this plugin's text domain and prefixes.</description>

	<file>linker-tools.php</file>
	<file>includes</file>
	<file>tests/php</file>
	<file>../../tools/php/bootstrap.php</file>

	<rule ref="../../tools/php/phpcs.xml"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="linker-tools"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Linker\Tools"/>
				<element value="linker_tools"/>
			</property>
		</properties>
	</rule>
</ruleset>
