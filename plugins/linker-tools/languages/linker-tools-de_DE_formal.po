#: includes/Genie/QualityStore.php
#, php-format
msgid "Genie quality check, last 24 hours: %1$d answers judged, %2$d flagged, %3$d decided by the second judge, %4$d could not be judged."
msgstr "Genie-Qualitätsprüfung, letzte 24 Stunden: %1$d Antworten bewertet, %2$d markiert, %3$d vom zweiten Prüfer entschieden, %4$d konnten nicht bewertet werden."

#: includes/Genie/QualityStore.php
msgid "The quality check has stopped reporting."
msgstr "Die Qualitätsprüfung meldet sich nicht mehr."

#: includes/Genie/QualityPage.php
msgid "Genie quality check"
msgstr "Genie-Qualitätsprüfung"

#: includes/Genie/QualityPage.php
msgid "Genie quality"
msgstr "Genie-Qualität"

#: includes/Genie/QualityPage.php
msgid "never"
msgstr "nie"

#: includes/Genie/QualityPage.php
#, php-format
msgid "The quality check has stopped reporting. Last report: %s."
msgstr "Die Qualitätsprüfung meldet sich nicht mehr. Letzte Meldung: %s."

#: includes/Genie/QualityPage.php
#, php-format
msgid "Last judge error (%1$s): %2$s"
msgstr "Letzter Fehler der Prüfung (%1$s): %2$s"

#: includes/Genie/QualityPage.php
#, php-format
msgid "Judge: %1$s; when unsure: %2$s. Last report: %3$s. Waiting for a retry: %4$d. Given up: %5$d."
msgstr "Prüfer: %1$s; bei Unsicherheit: %2$s. Letzte Meldung: %3$s. Warten auf einen neuen Versuch: %4$d. Aufgegeben: %5$d."

#: includes/Genie/QualityPage.php
msgid "Every answer Genie gives is judged after it is sent: is it supported by what Genie looked up, does it stay within Genie's remit, and would a wrong product have been judged better. Answers flagged here need a look."
msgstr "Jede Antwort von Genie wird nach dem Versand geprüft: ob das, was Genie nachgeschlagen hat, sie deckt, ob sie im Aufgabenbereich von Genie bleibt und ob ein falsches Produkt besser abgeschnitten hätte. Markierte Antworten sollten Sie sich ansehen."

