<?xml version="1.0"?>
<!--
	Integration tests: the plugin inside a real WordPress, a local instance of
	`just up` (docs/specs/5-local-stack.md) whose plugins/linker-tools is this
	checkout. LINKER_WP_ROOT names the instance's WordPress directory.
	The tests write conversations into that instance and remove them again;
	they never reach the live site (the instance's isolation mu-plugin keeps
	mail and HTTP local).
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/php/integration-bootstrap.php"
	colors="true"
	failOnRisky="true"
	failOnWarning="true"
	convertDeprecationsToExceptions="false"
	convertNoticesToExceptions="false"
>
	<php>
		<ini name="memory_limit" value="2048M"/>
		<env name="LINKER_INTEGRATION" value="1"/>
	</php>
	<testsuites>
		<testsuite name="integration">
			<directory>tests/php/Integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
