{
	"$defs": {
		"Location": {
			"additionalProperties": false,
			"properties": {
				"latitude": {
					"maximum": 71.5,
					"minimum": 27.0,
					"title": "Latitude",
					"type": "number"
				},
				"longitude": {
					"maximum": 47.0,
					"minimum": -32.0,
					"title": "Longitude",
					"type": "number"
				}
			},
			"required": [
				"latitude",
				"longitude"
			],
			"title": "Location",
			"type": "object"
		},
		"PanelDimensions": {
			"additionalProperties": false,
			"description": "Declared panel dimensions and rated power for a roof packing calculation.",
			"properties": {
				"pmax_w": {
					"exclusiveMinimum": 0,
					"title": "Pmax W",
					"type": "number"
				},
				"length_m": {
					"exclusiveMinimum": 0,
					"title": "Length M",
					"type": "number"
				},
				"width_m": {
					"exclusiveMinimum": 0,
					"title": "Width M",
					"type": "number"
				}
			},
			"required": [
				"pmax_w",
				"length_m",
				"width_m"
			],
			"title": "PanelDimensions",
			"type": "object"
		}
	},
	"additionalProperties": false,
	"properties": {
		"module": {
			"$ref": "#/$defs/PanelDimensions"
		},
		"plz": {
			"description": "European postcode (PLZ) as its country writes it",
			"maxLength": 12,
			"minLength": 2,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9 -]*$",
			"title": "Plz",
			"type": "string"
		},
		"country": {
			"anyOf": [
				{
					"pattern": "^[A-Z]{2}$",
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"title": "Country"
		},
		"location": {
			"$ref": "#/$defs/Location"
		},
		"locale": {
			"default": "en",
			"enum": [
				"en",
				"de"
			],
			"title": "Locale",
			"type": "string"
		}
	},
	"required": [
		"module",
		"plz",
		"location"
	],
	"title": "RoofRequest",
	"type": "object"
}
