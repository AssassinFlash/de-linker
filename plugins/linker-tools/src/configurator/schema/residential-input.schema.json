{
	"$defs": {
		"Location": {
			"additionalProperties": false,
			"properties": {
				"latitude": {
					"maximum": 71.5,
					"minimum": 27.0,
					"title": "Latitude",
					"type": "number"
				},
				"longitude": {
					"maximum": 47.0,
					"minimum": -32.0,
					"title": "Longitude",
					"type": "number"
				}
			},
			"required": [
				"latitude",
				"longitude"
			],
			"title": "Location",
			"type": "object"
		},
		"PanelElectrical": {
			"additionalProperties": false,
			"description": "Declared panel values used by a string design, independent of stock.",
			"properties": {
				"pmax_w": {
					"exclusiveMinimum": 0,
					"title": "Pmax W",
					"type": "number"
				},
				"voc_v": {
					"exclusiveMinimum": 0,
					"title": "Voc V",
					"type": "number"
				},
				"vmpp_v": {
					"exclusiveMinimum": 0,
					"title": "Vmpp V",
					"type": "number"
				},
				"isc_a": {
					"exclusiveMinimum": 0,
					"title": "Isc A",
					"type": "number"
				},
				"impp_a": {
					"exclusiveMinimum": 0,
					"title": "Impp A",
					"type": "number"
				},
				"beta_voc_pct_per_c": {
					"maximum": 0,
					"title": "Beta Voc Pct Per C",
					"type": "number"
				},
				"max_series_fuse_a": {
					"exclusiveMinimum": 0,
					"title": "Max Series Fuse A",
					"type": "number"
				}
			},
			"required": [
				"pmax_w",
				"voc_v",
				"vmpp_v",
				"isc_a",
				"impp_a",
				"beta_voc_pct_per_c",
				"max_series_fuse_a"
			],
			"title": "PanelElectrical",
			"type": "object"
		},
		"PlaneInput": {
			"additionalProperties": false,
			"description": "One roof plane of the array. Without planes the array is one plane at the default tilt and facing.",
			"properties": {
				"kwp": {
					"exclusiveMinimum": 0,
					"maximum": 100,
					"title": "Kwp",
					"type": "number"
				},
				"tilt_deg": {
					"maximum": 90,
					"minimum": 0,
					"title": "Tilt Deg",
					"type": "number"
				},
				"azimuth_deg": {
					"description": "Facing: north 0, east 90, south 180, west 270",
					"exclusiveMaximum": 360,
					"minimum": 0,
					"title": "Azimuth Deg",
					"type": "number"
				}
			},
			"required": [
				"kwp",
				"tilt_deg",
				"azimuth_deg"
			],
			"title": "PlaneInput",
			"type": "object"
		}
	},
	"additionalProperties": false,
	"properties": {
		"module": {
			"anyOf": [
				{
					"$ref": "#/$defs/PanelElectrical"
				},
				{
					"type": "null"
				}
			],
			"default": null
		},
		"locale": {
			"default": "en",
			"enum": [
				"en",
				"de"
			],
			"title": "Locale",
			"type": "string"
		},
		"plz": {
			"description": "European postcode (PLZ) as its country writes it",
			"maxLength": 12,
			"minLength": 2,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9 -]*$",
			"title": "Plz",
			"type": "string"
		},
		"country": {
			"anyOf": [
				{
					"pattern": "^[A-Z]{2}$",
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"title": "Country"
		},
		"annual_kwh": {
			"description": "Annual household consumption. The bounds only reject typing errors; where the methods are valid is checked and reported separately.",
			"maximum": 50000,
			"minimum": 500,
			"title": "Annual Kwh",
			"type": "number"
		},
		"pv_kwp": {
			"exclusiveMinimum": 0,
			"maximum": 100,
			"title": "Pv Kwp",
			"type": "number"
		},
		"planes": {
			"anyOf": [
				{
					"items": {
						"$ref": "#/$defs/PlaneInput"
					},
					"type": "array"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"title": "Planes"
		},
		"location": {
			"anyOf": [
				{
					"$ref": "#/$defs/Location"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "The roof's position from the roof step; otherwise the PLZ centre."
		},
		"roof_source": {
			"anyOf": [
				{
					"enum": [
						"lod2",
						"drawn"
					],
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Where the planes come from: the state's official LoD2 building model (the report credits it under its licence) or drawn by hand on the aerial image.",
			"title": "Roof Source"
		},
		"phase": {
			"enum": [
				1,
				3
			],
			"title": "Phase",
			"type": "integer"
		},
		"backup": {
			"default": "none",
			"enum": [
				"none",
				"needed",
				"needed_accessory_ok"
			],
			"title": "Backup",
			"type": "string"
		},
		"backup_load_kw": {
			"anyOf": [
				{
					"exclusiveMinimum": 0,
					"maximum": 50,
					"type": "number"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"title": "Backup Load Kw"
		},
		"backup_hours": {
			"anyOf": [
				{
					"exclusiveMinimum": 0,
					"maximum": 72,
					"type": "number"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"title": "Backup Hours"
		},
		"heat_pump": {
			"default": false,
			"title": "Heat Pump",
			"type": "boolean"
		},
		"electric_vehicle": {
			"default": false,
			"title": "Electric Vehicle",
			"type": "boolean"
		},
		"existing_inverter": {
			"anyOf": [
				{
					"maxLength": 80,
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Model of an inverter already installed (retrofit).",
			"title": "Existing Inverter"
		},
		"inverter_id": {
			"anyOf": [
				{
					"type": "integer"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Swap: use this inverter.",
			"title": "Inverter Id"
		},
		"battery_id": {
			"anyOf": [
				{
					"type": "integer"
				},
				{
					"type": "null"
				}
			],
			"default": null,
			"description": "Swap: use this battery.",
			"title": "Battery Id"
		}
	},
	"required": [
		"plz",
		"annual_kwh",
		"pv_kwp",
		"phase"
	],
	"title": "ResidentialInput",
	"type": "object"
}
