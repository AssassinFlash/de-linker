{
	"name": "linker-tools",
	"version": "0.1.0",
	"private": true,
	"description": "Genie and Solution Configurator front-end apps for de-linker.com.",
	"license": "UNLICENSED",
	"//": [
		"react, react-dom and @wordpress/{dom-ready,element,i18n}: the versions WordPress 7.1.3 ships (react 18.3.1 in wordpress-develop 7.1.3/package.json; the @wordpress packages at the Gutenberg commit it pins, dd294ab8). The build leaves them external; these copies serve tests and types.",
		"typescript stays on 6.0: typescript-eslint 8.71.1, which @wordpress/eslint-plugin 27 uses, accepts typescript >=4.8.4 <6.1.0."
	],
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"build": "node bin/build.cjs && node bin/build-manifest.mjs write",
		"build:check": "node bin/build-manifest.mjs check",
		"start": "wp-scripts start",
		"format": "prettier --write .",
		"lint:format": "prettier --check .",
		"lint:js": "wp-scripts lint-js --max-warnings=0",
		"lint:types": "tsc --noEmit",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "playwright test",
		"storybook": "storybook dev"
	},
	"dependencies": {
		"@wordpress/dom-ready": "4.51.0",
		"@wordpress/element": "8.3.0",
		"@wordpress/i18n": "6.24.0",
		"ajv": "8.20.0",
		"maplibre-gl": "5.24.0",
		"markdown-it": "14.3.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-hook-form": "7.88.0",
		"terra-draw": "1.35.0",
		"terra-draw-maplibre-gl-adapter": "1.4.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@storybook/react-vite": "^10.6.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/prettier-config": "^4.56.0",
		"@wordpress/scripts": "^36.0.0",
		"jsdom": "^26.1.0",
		"storybook": "^10.6.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}
