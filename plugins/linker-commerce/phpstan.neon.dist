# The shared plugin settings (level, stubs, test bootstrap) live in
# tools/php/phpstan-plugins.neon.
includes:
	- ../../tools/php/phpstan-plugins.neon
	# Mockery::mock(X::class) is an X in the tests.
	- vendor/phpstan/phpstan-mockery/extension.neon

parameters:
	paths:
		- linker-commerce.php
		- includes
		- tests/php
		# The local seeding of the test fixture, run with `wp eval-file`.
		- tests/fixtures
		# The data migrations of the products this plugin reads (tools/migrate/*.php, run with `wp eval-file -`).
		- ../../tools/migrate
		# The FAQ field import of ticket #15.
		- ../../tools/faq/wordpress.php
	excludePaths:
		# Stand-ins for WordPress and WooCommerce classes; PHPStan reads the real ones from the stubs.
		- tests/php/Doubles
	scanDirectories:
		# Genie's routes of the companion plugin: the filter and action contracts of
		# "email me this conversation" (#235) and "Let Linker contact me" (#243)
		# span both plugins, and the integration tests drive linker-tools' side
		# with this plugin's mail (ContactRequest, FormGuard, RateLimit).
		- ../linker-tools/includes/Genie
	scanFiles:
		# The existing language helper is supplied by the companion plugin.
		- ../linker-i18n/includes/Languages.php
		# WP_CLI (the commands call WP_CLI::error/warning/log/success and catch
		# WP_CLI\ExitException); wp-cli is not in the WordPress stubs. The
		# runtime doubles live in wordpress.php, which stays out of analysis so
		# the real WP_Post/WP_REST_Request stubs are not shadowed.
		- tests/php/Doubles/wp-cli-stubs.php
		# Action Scheduler (as_schedule_single_action()), bundled with WooCommerce.
		- vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
		# Polylang's API (PLL(), pll_current_language()); the plugin reads it when present.
		- vendor/wpsyntex/polylang-stubs/polylang-stubs.php
		# WP_Mock declares its hook responders next to the hooks, outside the autoloader.
		- vendor/10up/wp_mock/php/WP_Mock/Action.php
		- vendor/10up/wp_mock/php/WP_Mock/Filter.php
		- vendor/10up/wp_mock/php/WP_Mock/HookedCallback.php
