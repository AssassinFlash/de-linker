{
	"name": "linker/linker-commerce",
	"description": "Inquiry chain, product facts and Abilities for de-linker.com.",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"10up/wp_mock": "^1.1",
		"php-stubs/woocommerce-stubs": "~11.2.0",
		"php-stubs/wordpress-stubs": "~7.1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"woocommerce/woocommerce-sniffs": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload": {
		"psr-4": {
			"Linker\\Commerce\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Linker\\Commerce\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	}
}
