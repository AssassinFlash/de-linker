{
	"compilerOptions": {
		"target": "ESNext",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": [ "src", "vitest.config.mts", "vitest.setup.ts" ]
}
