#. Plugin Name of the plugin
msgid "Linker Commerce"
msgstr "Linker Commerce"

#. Description of the plugin
msgid "Inquiry chain, product facts and Abilities for de-linker.com."
msgstr "Anfragekette, Produktdaten und Abilities für de-linker.com."

#. Author of the plugin
msgid "Linker Technology GmbH"
msgstr "Linker Technology GmbH"

msgid "Get Linker Commerce version"
msgstr "Linker-Commerce-Version abrufen"

msgid "Returns the version of the Linker Commerce plugin installed on this site."
msgstr "Gibt die Version des auf dieser Website installierten Plugins Linker Commerce zurück."

msgid "Version from the plugin header."
msgstr "Version aus dem Plugin-Header."

msgid "Linker"
msgstr "Linker"

msgid "Products and inquiries of de-linker.com."
msgstr "Produkte und Anfragen von de-linker.com."

msgid "Figures and citations"
msgstr "Kenndaten und Quellenangaben"

msgid "This product states no figures."
msgstr "Dieses Produkt hat keine Kenndaten."

msgid "Changing a value or a unit requires the citation to be given again: the document and the page it is printed on."
msgstr "Wenn Sie einen Wert oder eine Einheit ändern, muss die Quellenangabe erneut angegeben werden: das Dokument und die Seite, auf der er steht."

msgid "Key"
msgstr "Schlüssel"

msgid "Value"
msgstr "Wert"

msgid "Unit"
msgstr "Einheit"

msgid "Document"
msgstr "Dokument"

msgid "Page"
msgstr "Seite"

msgid "— none —"
msgstr "— keines —"

msgid "No citation"
msgstr "Keine Quellenangabe"

#. translators: %s: list of figure keys.
#, php-format
msgid "Figures %s kept their previous value: a changed value needs the document and the page it is printed on."
msgstr "Die Kenndaten %s behalten ihren bisherigen Wert: Ein geänderter Wert benötigt das Dokument und die Seite, auf der er steht."

msgid "GMT timestamp or ISO-8601 moment; only products modified after it are returned."
msgstr "GMT-Zeitstempel oder ISO-8601-Zeitpunkt; zurückgegeben werden nur Produkte, die danach geändert wurden."

msgid "The engineering data of every published product, the overlay components and the compatibility version (docs/specs/8-engineering-data.md)."
msgstr "Die technischen Daten aller veröffentlichten Produkte, die Overlay-Komponenten und die Version des Kompatibilitätsvertrags (docs/specs/8-engineering-data.md)."

msgid "sha256 of data/compatibility.json."
msgstr "sha256 von data/compatibility.json."

msgid "Engineering components that are not products (data/engineering-overlay.json)."
msgstr "Technische Komponenten, die keine Produkte sind (data/engineering-overlay.json)."

msgid "One entry per published product."
msgstr "Ein Eintrag je veröffentlichtem Produkt."

msgid "Figure entries with a citation of a hosted document; a value without one is not in the feed."
msgstr "Kenndaten mit Quellenangabe eines von uns gehosteten Dokuments; ein Wert ohne Quellenangabe ist nicht im Feed."

#. translators: %d: most product IDs per request.
#, php-format
msgid "Product IDs, at most %d."
msgstr "Produkt-IDs, höchstens %d."

msgid "Selection facts of the requested published products, by product ID."
msgstr "Auswahlfakten der angeforderten veröffentlichten Produkte, nach Produkt-ID."

msgid "Product category the product is selected in."
msgstr "Produktkategorie, in der das Produkt ausgewählt wird."

msgid "Application (attribute pa_application)."
msgstr "Einsatzbereich (Attribut pa_application)."

msgid "Number of grid phases."
msgstr "Anzahl der Netzphasen."

msgid "Rated AC power in kW."
msgstr "Nennleistung (AC) in kW."

msgid "Maximum PV input power in kW."
msgstr "Maximale PV-Eingangsleistung in kW."

msgid "Usable energy in kWh."
msgstr "Nutzbare Energie in kWh."

msgid "Nominal energy in kWh."
msgstr "Nennenergie in kWh."

msgid "Energy range in kWh the product data states; present only then."
msgstr "Energiebereich in kWh, den die Produktdaten angeben; nur dann vorhanden."

msgid "Rated AC power the product data states in kVA; present only then."
msgstr "Nennleistung (AC) in kVA, die die Produktdaten angeben; nur dann vorhanden."
