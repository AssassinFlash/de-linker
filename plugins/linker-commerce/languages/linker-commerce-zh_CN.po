msgid "Daily digest"
msgstr "每日业务简报"

msgid "Sent to the internal notification address, with blind copies, every morning at 9:00 (Berlin time)."
msgstr "每天上午 9:00（柏林时间）发送至内部通知地址，并附密送。"

msgid "Daily digest, {date}"
msgstr "【Linker 业务简报】{date}{summary}"

msgid "%d 条待跟进"
msgstr "%d 条待跟进"

msgid "%d 个待审客户"
msgstr "%d 个待审客户"

msgid "Accounts waiting for approval"
msgstr "待审核客户账号"

msgid "No account is waiting for approval."
msgstr "暂无等待审核的客户账号。"

msgid "Restricted, awaiting customer information: %s"
msgstr "受限账户（等待补充信息）：%s"

msgid "View restricted accounts"
msgstr "查看受限账户列表"

msgid "Open the customer"
msgstr "查看客户资料"

msgid "Registered on %s"
msgstr "注册于 %s"

msgid "Inquiries waiting for your follow-up"
msgstr "待跟进的询盘"

msgid "No inquiry is waiting for more than 24 hours."
msgstr "暂无等待超过 24 小时的询盘。"

msgid "Inquiry #%1$s – %2$s"
msgstr "询盘 #%1$s – %2$s"

msgid "Received on %1$s at %2$s (%3$s)"
msgstr "接收于 %1$s %2$s（%3$s）"

msgid "Open the inquiry"
msgstr "查看询盘"

msgid "Quotations in preparation for more than 3 days"
msgstr "报价单已开具超 3 天未闭环"

msgid "No Quotation has waited more than 3 days for a reply."
msgstr "暂无报价单超过 3 天未收到回复。"

msgid "Quotation %1$s issued on %2$s at %3$s (%4$s)"
msgstr "报价单 %1$s 开具于 %2$s %3$s（%4$s）"

msgid "Emails that could not be delivered"
msgstr "邮件发送失败记录"

msgid "No email failed to send."
msgstr "暂无邮件发送失败记录。"

msgid "To: %1$s – Error: %2$s"
msgstr "收件人：%1$s – 错误：%2$s"

msgid "Internal mail authentication"
msgstr "系统发信鉴权状态"

msgid "Last SMTP attempt succeeded at %s UTC."
msgstr "最近一次 SMTP 发信测试成功于 %s UTC。"

msgid "SMTP configured; no SMTP attempt has been recorded."
msgstr "已配置 SMTP，暂无发信记录。"

msgid "The last SMTP attempt failed."
msgstr "最近一次 SMTP 发信尝试失败。"

msgid "Last attempt: %1$s UTC. Reason: %2$s. Internal notifications fall back to PHP mail()."
msgstr "最近尝试时刻：%1$s UTC。原因：%2$s。内部通知已自动降级至 PHP mail()。"

msgid "Internal mail not authenticated."
msgstr "内部发信未通过 SMTP 鉴权。"

msgid "Internal notifications use PHP mail(). Check the SMTP configuration on the server."
msgstr "内部通知当前使用 PHP mail()。请检查服务器上的 SMTP 配置。"

msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d 小时前"

msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "%d 天前"


msgid "No saved inquiry is awaiting staff review."
msgstr "目前没有等待人工复核的已保存询盘。"

msgid "%d saved inquiries need staff review."
msgstr "%d 条已保存的询盘需要人工复核。"

msgid "%1$d saved inquiries need verification or staff review.\nOldest inquiry: %2$s ago.\nCount checked: %3$s.\nReview saved inquiries: %4$s\n\nThese inquiries are saved. Their individual team notifications have not been released."
msgstr "%1$d 条已保存的询盘需要核验或人工复核。\n最早一条询盘保存于 %2$s 前。\n统计时间：%3$s。\n查看并复核已保存的询盘：%4$s\n\n这些询盘已保存。它们各自的团队通知仍在暂缓状态。"

msgid "Saved inquiries need staff review"
msgstr "有已保存的询盘等待人工复核"

msgid "Inquiries awaiting staff review"
msgstr "等待人工复核的询盘"

msgid "Oldest inquiry: %s ago."
msgstr "最早一条询盘保存于 %s 前。"

msgid "Pending inquiry counts are unavailable."
msgstr "暂时无法核实待复核询盘的数量。"

msgid "Review saved inquiries"
msgstr "查看并复核已保存的询盘"

msgid "Saved inquiries awaiting staff review: %1$d.\nOldest inquiry: %2$s ago.\nCount checked: %3$s.\nReview saved inquiries: %4$s\n\nThese inquiries are saved. Their individual team notifications have not been released."
msgstr "已保存、待人工复核的询盘：%1$d。\n最早一条询盘保存于 %2$s 前。\n统计时间：%3$s。\n查看并复核已保存的询盘：%4$s\n\n这些询盘已保存。它们各自的团队通知仍在暂缓状态。"

msgid "Saved inquiries awaiting staff review: %d."
msgstr "已保存、待人工复核的询盘：%d。"
msgid "Operations health"
msgstr "运行健康"

msgid "The delivery queue could not be read."
msgstr "暂时无法读取投递队列。"

msgid "%d queued delivery action(s) are more than a day overdue."
msgstr "%d 条排队中的投递任务已逾期超过一天。"

msgid "Queue: %1$s pending in total. The latest action was due %2$s. Retries end after 24 hours, so an action this late is stuck rather than retrying."
msgstr "队列：共 %1$s 条待执行，最晚一条本应在 %2$s 前执行。重试最多覆盖 24 小时，晚到这种程度已不是重试，而是卡住。"

msgid "The mail budget could not be read."
msgstr "暂时无法读取邮件额度。"

msgid "The pending-review queue could not be read."
msgstr "暂时无法读取待复核队列。"

msgid "The unhandled inquiry envelope could not be read."
msgstr "暂时无法读取未处理询盘的上限占用。"

msgid "%1$d unhandled inquiries are near the site envelope of %2$d."
msgstr "未处理询盘 %1$d 条，已接近站点上限 %2$d 条。"

msgid "Occupied logical data: %1$s of %2$s. At the envelope the site refuses a genuine new submission."
msgstr "已占用逻辑数据 %1$s，上限 %2$s。达到上限时站点会拒绝真实客户的新提交。"

msgid "%1$d inquiries are quarantined against a review lane of %2$d."
msgstr "隔离中的询盘 %1$d 条，复核车道容量 %2$d 条。"

msgid "A full lane refuses a genuine new submission. #568 measured 102 unhandled when the 2026-10-22 wave was live; dispose the backlog or confirm the wave is expected before the lane fills."
msgstr "车道占满后站点会拒绝真实客户的新提交。2026-10-22 攻击波期间实测未处理峰值为 102 条；请在车道占满前处置积压，或确认这波流量符合预期。"

msgid "The publication manifest could not be read."
msgstr "暂时无法读取发布清单。"

msgid "Engineering feed prepared %1$d of %2$d products."
msgstr "工程数据源已就绪 %1$d / %2$d 个产品。"

msgid "The planner builds from this feed. An all-zero reading was the 2026-11-11 signature after a pull changed every product revision; run the publication repair and confirm the dry run reports no backlog."
msgstr "方案配置器依据这份数据源生成方案。2026-11-11 出现全零读数，成因是拉取后产品修订号全部失配；请执行发布修复，并确认试运行报告的积压为零。"

msgid "queue unreadable"
msgstr "队列无法读取"

msgid "queue %1$s (%2$s)"
msgstr "队列 %1$s（%2$s）"

msgid "nothing late"
msgstr "无逾期"

msgid "mail unreadable"
msgstr "邮件额度无法读取"

msgid "mail %1$d/%2$d PHP, %3$d/%4$d SMTP"
msgstr "邮件 %1$d/%2$d PHP，%3$d/%4$d SMTP"

msgid "intake unreadable"
msgstr "询盘占用无法读取"

msgid "intake %1$d/%2$d unhandled, %3$d quarantined"
msgstr "询盘 %1$d/%2$d 未处理，%3$d 条隔离"

msgid "publication unreadable"
msgstr "发布状态无法读取"

msgid "publication %1$d/%2$d engineering, %3$d knowledge"
msgstr "发布 %1$d/%2$d 工程就绪，%3$d 知识就绪"

msgid "All within bounds — %s."
msgstr "各项均在上限内——%s。"

msgid "PHP mail()"
msgstr "PHP mail()"

msgid "SMTP"
msgstr "SMTP"

msgid "%1$s has used %2$d of %3$d daily attempts."
msgstr "%1$s 本日已用 %2$d / %3$d 次。"

msgid "Ordinary mail stops at %1$d; the last %2$d attempts are held for password resets, approvals and staff alerts. Customer acknowledgements wait for the rolling window to move on."
msgstr "普通邮件在 %1$d 次后停止，最后 %2$d 次留给密码重置、账号审批与员工告警。客户回执需等滚动窗口前移后才能发出。"

msgid "This is not a zero reading: the measurement itself failed, so nothing about this dimension is known today."
msgstr "这不是零读数：测量本身失败，因此今天对该维度一无所知。"

msgid "at least %d"
msgstr "至少 %d"

msgid "%d hour late"
msgid_plural "%d hours late"
msgstr[0] "晚 %d 小时"

msgid "%d day late"
msgid_plural "%d days late"
msgstr[0] "晚 %d 天"
