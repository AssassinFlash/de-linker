<?xml version="1.0"?>
<ruleset name="Linker i18n">
	<description>Linker i18n: the shared plugin rules (tools/php/phpcs.xml) with this plugin's text domain and prefixes.</description>

	<file>linker-i18n.php</file>
	<file>includes</file>
	<file>tests</file>
	<file>../../tools/php/bootstrap.php</file>

	<rule ref="../../tools/php/phpcs.xml"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<!-- The plugin's own strings; WooCommerce's own wrapper string the
			add-to-cart notice is rebuilt with (Woo/Storefront.php), so its quotes
			follow the locale; and core's own 404 sentence, which the 404 title
			filter takes from the core language pack (Seo::not_found_title)
			because SEOPress stores that title as an option, out of gettext's
			reach. -->
			<property name="text_domain" type="array">
				<element value="linker-i18n"/>
				<element value="woocommerce"/>
				<element value="default"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Linker\I18n"/>
				<element value="linker_i18n"/>
			</property>
		</properties>
	</rule>
</ruleset>
