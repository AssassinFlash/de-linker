{
	"$defs": {
		"Count": {
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"type": "integer"
		},
		"Identifier": {
			"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
			"type": "string"
		},
		"PvString": {
			"additionalProperties": false,
			"properties": {
				"id": {
					"$ref": "#/$defs/Identifier"
				},
				"mppt": {
					"$ref": "#/$defs/Count"
				},
				"input": {
					"$ref": "#/$defs/Count"
				},
				"module_ids": {
					"items": {
						"minLength": 1,
						"type": "string"
					},
					"minItems": 1,
					"title": "Module Ids",
					"type": "array"
				}
			},
			"required": ["id", "mppt", "input", "module_ids"],
			"title": "PvString",
			"type": "object"
		},
		"SchemaVersion": {
			"maximum": 1,
			"minimum": 1,
			"type": "integer"
		}
	},
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"$ref": "#/$defs/SchemaVersion"
		},
		"inverter_product_id": {
			"$ref": "#/$defs/Count"
		},
		"minimum_ambient_c": {
			"anyOf": [
				{
					"minimum": -273.15,
					"type": "number"
				},
				{
					"type": "null"
				}
			],
			"title": "Minimum Ambient C"
		},
		"temperature_source": {
			"anyOf": [
				{
					"maxLength": 4096,
					"minLength": 1,
					"type": "string"
				},
				{
					"type": "null"
				}
			],
			"title": "Temperature Source"
		},
		"strings": {
			"items": {
				"$ref": "#/$defs/PvString"
			},
			"title": "Strings",
			"type": "array"
		}
	},
	"required": [
		"schema_version",
		"inverter_product_id",
		"minimum_ambient_c",
		"temperature_source",
		"strings"
	],
	"title": "PvStringPlan",
	"type": "object"
}
