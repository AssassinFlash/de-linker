{
  "$defs": {
    "ControlNetwork": {
      "enum": [
        "lan",
        "rs485"
      ],
      "type": "string"
    },
    "Count": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "EquipmentRequirements": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "grid_phase": {
          "$ref": "#/$defs/GridPhase"
        },
        "operating_mode": {
          "enum": [
            "grid_connected",
            "backup"
          ],
          "title": "Operating Mode",
          "type": "string"
        },
        "pv_dc_kw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_usable_kwh": {
          "$ref": "#/$defs/Nonnegative"
        },
        "required_discharge_ac_kw": {
          "$ref": "#/$defs/Nonnegative"
        }
      },
      "required": [
        "schema_version",
        "grid_phase",
        "operating_mode",
        "pv_dc_kw",
        "required_usable_kwh",
        "required_discharge_ac_kw"
      ],
      "title": "EquipmentRequirements",
      "type": "object"
    },
    "EquipmentSelection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "inverter_product_id": {
          "$ref": "#/$defs/Count"
        },
        "battery_product_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "modules_per_stack": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "parallel_stacks": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessory_product_ids": {
          "items": {
            "$ref": "#/$defs/Count"
          },
          "title": "Accessory Product Ids",
          "type": "array"
        },
        "grid_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridPhase"
            },
            {
              "type": "null"
            }
          ]
        },
        "operating_mode": {
          "enum": [
            "grid_connected",
            "backup"
          ],
          "title": "Operating Mode",
          "type": "string"
        },
        "pv_dc_kw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_usable_kwh": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_discharge_ac_kw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "product_revisions": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Product Revisions",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "inverter_product_id",
        "battery_product_id",
        "modules_per_stack",
        "parallel_stacks",
        "accessory_product_ids",
        "grid_phase",
        "operating_mode",
        "pv_dc_kw",
        "required_usable_kwh",
        "required_discharge_ac_kw",
        "product_revisions"
      ],
      "title": "EquipmentSelection",
      "type": "object"
    },
    "GridPhase": {
      "enum": [
        1,
        3
      ],
      "type": "integer"
    },
    "Identity": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "Nonnegative": {
      "minimum": 0,
      "type": "number"
    },
    "ParallelGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identity"
        },
        "unit_ids": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "minItems": 2,
          "title": "Unit Ids",
          "type": "array"
        },
        "controller_product_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "controller_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_network": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlNetwork"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "unit_ids",
        "controller_product_id",
        "controller_revision"
      ],
      "title": "ParallelGroup",
      "type": "object"
    },
    "PlantUnit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identity"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/EquipmentSelection"
        }
      },
      "required": [
        "id",
        "name",
        "selection"
      ],
      "title": "PlantUnit",
      "type": "object"
    },
    "Revision": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "SchemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "requirements": {
      "$ref": "#/$defs/EquipmentRequirements"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/PlantUnit"
      },
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "parallel_groups": {
      "items": {
        "$ref": "#/$defs/ParallelGroup"
      },
      "title": "Parallel Groups",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "requirements",
    "units",
    "parallel_groups"
  ],
  "title": "EquipmentPlant",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
