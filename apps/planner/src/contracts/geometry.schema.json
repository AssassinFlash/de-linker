{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CoordinateSystem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local_enu",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "const": "m",
          "title": "Unit",
          "type": "string"
        },
        "height_reference": {
          "const": "relative_to_project_origin",
          "title": "Height Reference",
          "type": "string"
        },
        "north_reference": {
          "enum": [
            "true_north",
            "user_declared",
            "unreferenced"
          ],
          "title": "North Reference",
          "type": "string"
        },
        "north_source_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeographicAnchor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "unit",
        "height_reference",
        "north_reference",
        "north_source_id",
        "anchor"
      ],
      "title": "CoordinateSystem",
      "type": "object"
    },
    "GeographicAnchor": {
      "additionalProperties": false,
      "properties": {
        "latitude_deg": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude Deg",
          "type": "number"
        },
        "longitude_deg": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude Deg",
          "type": "number"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "datum": {
          "const": "EPSG:4326",
          "title": "Datum",
          "type": "string"
        }
      },
      "required": [
        "latitude_deg",
        "longitude_deg",
        "source_id",
        "datum"
      ],
      "title": "GeographicAnchor",
      "type": "object"
    },
    "GeometrySource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "user_measurement",
            "user_drawing",
            "licensed_dataset",
            "synthetic_fixture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "$ref": "#/$defs/Text"
        },
        "rights_note": {
          "$ref": "#/$defs/Text"
        },
        "reference_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "acquired_at_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "spatial_precision_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration_note": {
          "$ref": "#/$defs/Text"
        },
        "rights_basis": {
          "enum": [
            "user_attestation",
            "referenced_licence",
            "synthetic"
          ],
          "title": "Rights Basis",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/SourcePermissions"
        }
      },
      "required": [
        "id",
        "kind",
        "note",
        "rights_note",
        "reference_url",
        "reference_sha256",
        "acquired_at_utc",
        "spatial_precision_m",
        "calibration_note",
        "rights_basis",
        "permissions"
      ],
      "title": "GeometrySource",
      "type": "object"
    },
    "Hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Identifier": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "Keepout": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "roof_id": {
          "$ref": "#/$defs/Identifier"
        },
        "footprint_uv": {
          "$ref": "#/$defs/Ring"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "name",
        "source_id",
        "roof_id",
        "footprint_uv",
        "reason"
      ],
      "title": "Keepout",
      "type": "object"
    },
    "ModuleSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "datasheet",
            "user_declared"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "$ref": "#/$defs/Text"
        },
        "document_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveInteger"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "note",
        "document_sha256",
        "url",
        "page"
      ],
      "title": "ModuleSource",
      "type": "object"
    },
    "ModuleSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "model": {
          "$ref": "#/$defs/Text"
        },
        "width_m": {
          "$ref": "#/$defs/Positive"
        },
        "length_m": {
          "$ref": "#/$defs/Positive"
        },
        "thickness_m": {
          "$ref": "#/$defs/Positive"
        },
        "stc_power_w": {
          "$ref": "#/$defs/Positive"
        },
        "source": {
          "$ref": "#/$defs/ModuleSource"
        }
      },
      "required": [
        "id",
        "model",
        "width_m",
        "length_m",
        "thickness_m",
        "stc_power_w",
        "source"
      ],
      "title": "ModuleSpec",
      "type": "object"
    },
    "Nonnegative": {
      "minimum": 0,
      "type": "number"
    },
    "Number": {
      "type": "number"
    },
    "Obstacle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "roof_id": {
          "$ref": "#/$defs/Identifier"
        },
        "footprint_uv": {
          "$ref": "#/$defs/Ring"
        },
        "extrusion_axis_enu": {
          "$ref": "#/$defs/Vec3"
        },
        "height_m": {
          "$ref": "#/$defs/Positive"
        }
      },
      "required": [
        "id",
        "name",
        "source_id",
        "roof_id",
        "footprint_uv",
        "extrusion_axis_enu",
        "height_m"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "PanelArray": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "roof_id": {
          "$ref": "#/$defs/Identifier"
        },
        "module_spec_id": {
          "$ref": "#/$defs/Identifier"
        },
        "origin_uv": {
          "$ref": "#/$defs/Vec2"
        },
        "rotation_deg": {
          "$ref": "#/$defs/Number"
        },
        "mount_tilt_deg": {
          "maximum": 90,
          "minimum": 0,
          "title": "Mount Tilt Deg",
          "type": "number"
        },
        "lower_edge_clearance_m": {
          "$ref": "#/$defs/Nonnegative"
        },
        "rows": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "columns": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "column_gap_m": {
          "$ref": "#/$defs/Nonnegative"
        },
        "row_gap_m": {
          "$ref": "#/$defs/Nonnegative"
        },
        "excluded_slots": {
          "items": {
            "pattern": "^[0-9]+:[0-9]+$",
            "type": "string"
          },
          "title": "Excluded Slots",
          "type": "array"
        },
        "mounting_note": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "name",
        "source_id",
        "roof_id",
        "module_spec_id",
        "origin_uv",
        "rotation_deg",
        "mount_tilt_deg",
        "lower_edge_clearance_m",
        "rows",
        "columns",
        "column_gap_m",
        "row_gap_m",
        "excluded_slots",
        "mounting_note"
      ],
      "title": "PanelArray",
      "type": "object"
    },
    "Permission": {
      "enum": [
        "permitted",
        "unknown",
        "prohibited"
      ],
      "type": "string"
    },
    "Positive": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "PositiveInteger": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "Ring": {
      "items": {
        "$ref": "#/$defs/Vec2"
      },
      "minItems": 3,
      "type": "array"
    },
    "RoofFace": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "origin_enu": {
          "$ref": "#/$defs/Vec3"
        },
        "u_axis_enu": {
          "$ref": "#/$defs/Vec3"
        },
        "v_axis_enu": {
          "$ref": "#/$defs/Vec3"
        },
        "boundary_uv": {
          "$ref": "#/$defs/Ring"
        },
        "holes_uv": {
          "items": {
            "$ref": "#/$defs/Ring"
          },
          "title": "Holes Uv",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "source_id",
        "origin_enu",
        "u_axis_enu",
        "v_axis_enu",
        "boundary_uv",
        "holes_uv"
      ],
      "title": "RoofFace",
      "type": "object"
    },
    "RoofLayoutRules": {
      "additionalProperties": false,
      "properties": {
        "roof_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "edge_clearance_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "obstacle_clearance_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_note": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "roof_id",
        "source_id",
        "edge_clearance_m",
        "obstacle_clearance_m",
        "source_note"
      ],
      "title": "RoofLayoutRules",
      "type": "object"
    },
    "SchemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "SourcePermissions": {
      "additionalProperties": false,
      "properties": {
        "derive": {
          "$ref": "#/$defs/Permission"
        },
        "retain": {
          "$ref": "#/$defs/Permission"
        },
        "export": {
          "$ref": "#/$defs/Permission"
        }
      },
      "required": [
        "derive",
        "retain",
        "export"
      ],
      "title": "SourcePermissions",
      "type": "object"
    },
    "Text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "Vec2": {
      "items": {
        "$ref": "#/$defs/Number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "Vec3": {
      "items": {
        "$ref": "#/$defs/Number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "coordinate_system": {
      "$ref": "#/$defs/CoordinateSystem"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/GeometrySource"
      },
      "title": "Sources",
      "type": "array"
    },
    "roofs": {
      "items": {
        "$ref": "#/$defs/RoofFace"
      },
      "title": "Roofs",
      "type": "array"
    },
    "module_specs": {
      "items": {
        "$ref": "#/$defs/ModuleSpec"
      },
      "title": "Module Specs",
      "type": "array"
    },
    "arrays": {
      "items": {
        "$ref": "#/$defs/PanelArray"
      },
      "title": "Arrays",
      "type": "array"
    },
    "obstacles": {
      "items": {
        "$ref": "#/$defs/Obstacle"
      },
      "title": "Obstacles",
      "type": "array"
    },
    "keepouts": {
      "items": {
        "$ref": "#/$defs/Keepout"
      },
      "title": "Keepouts",
      "type": "array"
    },
    "layout_rules": {
      "items": {
        "$ref": "#/$defs/RoofLayoutRules"
      },
      "title": "Layout Rules",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "coordinate_system",
    "sources",
    "roofs",
    "module_specs",
    "arrays",
    "obstacles",
    "keepouts",
    "layout_rules"
  ],
  "title": "GeometryDocument",
  "type": "object"
}
