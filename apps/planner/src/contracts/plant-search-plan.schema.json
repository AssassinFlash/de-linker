{
  "$defs": {
    "ControlNetwork": {
      "enum": [
        "lan",
        "rs485"
      ],
      "type": "string"
    },
    "Count": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "EquipmentRequirements": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "grid_phase": {
          "$ref": "#/$defs/GridPhase"
        },
        "operating_mode": {
          "enum": [
            "grid_connected",
            "backup"
          ],
          "title": "Operating Mode",
          "type": "string"
        },
        "pv_dc_kw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nonnegative"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_usable_kwh": {
          "$ref": "#/$defs/Nonnegative"
        },
        "required_discharge_ac_kw": {
          "$ref": "#/$defs/Nonnegative"
        }
      },
      "required": [
        "schema_version",
        "grid_phase",
        "operating_mode",
        "pv_dc_kw",
        "required_usable_kwh",
        "required_discharge_ac_kw"
      ],
      "title": "EquipmentRequirements",
      "type": "object"
    },
    "GridPhase": {
      "enum": [
        1,
        3
      ],
      "type": "integer"
    },
    "Identity": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "Nonnegative": {
      "minimum": 0,
      "type": "number"
    },
    "SchemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "SearchGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identity"
        },
        "unit_ids": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "minItems": 2,
          "title": "Unit Ids",
          "type": "array"
        },
        "controller_product_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_network": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlNetwork"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "unit_ids",
        "controller_product_id"
      ],
      "title": "SearchGroup",
      "type": "object"
    },
    "SearchUnit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identity"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "requirements": {
          "$ref": "#/$defs/EquipmentRequirements"
        }
      },
      "required": [
        "id",
        "name",
        "requirements"
      ],
      "title": "SearchUnit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "requirements": {
      "$ref": "#/$defs/EquipmentRequirements"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/SearchUnit"
      },
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "parallel_groups": {
      "items": {
        "$ref": "#/$defs/SearchGroup"
      },
      "title": "Parallel Groups",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "requirements",
    "units",
    "parallel_groups"
  ],
  "title": "PlantSearchPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
