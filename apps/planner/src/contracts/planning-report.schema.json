{
  "$defs": {
    "ReportMonthlyChart": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "months": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Months",
          "type": "array"
        },
        "pv_kwh": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Pv Kwh",
          "type": "array"
        },
        "load_kwh": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 12,
              "minItems": 12,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Kwh"
        },
        "source_note": {
          "title": "Source Note",
          "type": "string"
        }
      },
      "required": [
        "title",
        "unit",
        "months",
        "pv_kwh",
        "load_kwh",
        "source_note"
      ],
      "title": "ReportMonthlyChart",
      "type": "object",
      "additionalProperties": false
    },
    "ReportPhaseConflict": {
      "properties": {
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "actual": {
          "enum": [
            1,
            3
          ],
          "title": "Actual",
          "type": "integer"
        },
        "required": {
          "enum": [
            1,
            3
          ],
          "title": "Required",
          "type": "integer"
        }
      },
      "required": [
        "unit",
        "actual",
        "required"
      ],
      "title": "ReportPhaseConflict",
      "type": "object",
      "additionalProperties": false
    },
    "ReportRow": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "href": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Href"
        }
      },
      "required": [
        "label",
        "value",
        "href"
      ],
      "title": "ReportRow",
      "type": "object",
      "additionalProperties": false
    },
    "ReportSection": {
      "properties": {
        "tier": {
          "default": "commercial",
          "enum": [
            "commercial",
            "appendix"
          ],
          "title": "Tier",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReportRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "paragraphs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportTable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "rows",
        "paragraphs",
        "table"
      ],
      "title": "ReportSection",
      "type": "object",
      "additionalProperties": false
    },
    "ReportSummaryCard": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "label",
        "value",
        "note"
      ],
      "title": "ReportSummaryCard",
      "type": "object",
      "additionalProperties": false
    },
    "ReportTable": {
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "column_weights": {
          "anyOf": [
            {
              "items": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Weights"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "ReportTable",
      "type": "object",
      "additionalProperties": false
    }
  },
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "subtitle": {
      "title": "Subtitle",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "locale": {
      "enum": [
        "en",
        "de"
      ],
      "title": "Locale",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "summary_cards": {
      "items": {
        "$ref": "#/$defs/ReportSummaryCard"
      },
      "title": "Summary Cards",
      "type": "array"
    },
    "monthly_chart": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportMonthlyChart"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "phase_conflicts": {
      "items": {
        "$ref": "#/$defs/ReportPhaseConflict"
      },
      "title": "Phase Conflicts",
      "type": "array"
    }
  },
  "required": [
    "title",
    "subtitle",
    "generated_at",
    "locale",
    "sections"
  ],
  "title": "Report",
  "type": "object",
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
