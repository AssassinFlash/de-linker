{
	"$defs": {
		"Measurement": {
			"enum": [
				"gross_load",
				"critical_load",
				"net_import",
				"pv_available_ac",
				"pv_generation_ac",
				"aux_ac"
			],
			"type": "string"
		},
		"SchemaVersion": {
			"maximum": 1,
			"minimum": 1,
			"type": "integer"
		}
	},
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"$ref": "#/$defs/SchemaVersion"
		},
		"selected": {
			"additionalProperties": {
				"pattern": "^[a-f0-9]{32}$",
				"type": "string"
			},
			"propertyNames": {
				"$ref": "#/$defs/Measurement"
			},
			"title": "Selected",
			"type": "object"
		}
	},
	"required": [
		"schema_version",
		"selected"
	],
	"title": "ProfileSelections",
	"type": "object"
}
