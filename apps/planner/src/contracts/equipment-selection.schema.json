{
  "$defs": {
    "Count": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "Nonnegative": {
      "minimum": 0,
      "type": "number"
    },
    "SchemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "inverter_product_id": {
      "$ref": "#/$defs/Count"
    },
    "battery_product_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Count"
        },
        {
          "type": "null"
        }
      ]
    },
    "modules_per_stack": {
      "anyOf": [
        {
          "$ref": "#/$defs/Count"
        },
        {
          "type": "null"
        }
      ]
    },
    "parallel_stacks": {
      "anyOf": [
        {
          "$ref": "#/$defs/Count"
        },
        {
          "type": "null"
        }
      ]
    },
    "accessory_product_ids": {
      "items": {
        "$ref": "#/$defs/Count"
      },
      "title": "Accessory Product Ids",
      "type": "array"
    },
    "grid_phase": {
      "anyOf": [
        {
          "enum": [
            1,
            3
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Grid Phase"
    },
    "operating_mode": {
      "enum": [
        "grid_connected",
        "backup"
      ],
      "title": "Operating Mode",
      "type": "string"
    },
    "pv_dc_kw": {
      "anyOf": [
        {
          "$ref": "#/$defs/Nonnegative"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_usable_kwh": {
      "anyOf": [
        {
          "$ref": "#/$defs/Nonnegative"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_discharge_ac_kw": {
      "anyOf": [
        {
          "$ref": "#/$defs/Nonnegative"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_revisions": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Product Revisions",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "inverter_product_id",
    "battery_product_id",
    "modules_per_stack",
    "parallel_stacks",
    "accessory_product_ids",
    "grid_phase",
    "operating_mode",
    "pv_dc_kw",
    "required_usable_kwh",
    "required_discharge_ac_kw",
    "product_revisions"
  ],
  "title": "EquipmentSelection",
  "type": "object"
}
