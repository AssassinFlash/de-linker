{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RunId": {
      "pattern": "^[a-f0-9]{32}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "locale": {
      "enum": [
        "en",
        "de"
      ],
      "title": "Locale",
      "type": "string"
    },
    "energy_run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "pv_run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "equipment_run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "logo": {
      "anyOf": [
        {
          "maxLength": 700000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Logo"
    }
  },
  "required": [
    "locale",
    "energy_run_id",
    "pv_run_id",
    "equipment_run_id",
    "logo"
  ],
  "title": "ReportOptions",
  "type": "object"
}
