{
  "$defs": {
    "Count": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "Identifier": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "PvOperatingConditions": {
      "additionalProperties": false,
      "properties": {
        "irradiance_w_m2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Irradiance W M2"
        },
        "hot_cell_c": {
          "anyOf": [
            {
              "minimum": -273.15,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hot Cell C"
        },
        "cold_cell_c": {
          "anyOf": [
            {
              "minimum": -273.15,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cold Cell C"
        },
        "source_note": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Note"
        }
      },
      "required": [
        "irradiance_w_m2",
        "hot_cell_c",
        "cold_cell_c",
        "source_note"
      ],
      "title": "PvOperatingConditions",
      "type": "object"
    },
    "PvPlantStringUnit": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/Identifier"
        },
        "inverter_instance_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "$ref": "#/$defs/PvStringPlan"
        }
      },
      "required": [
        "unit_id",
        "inverter_instance_id",
        "plan"
      ],
      "title": "PvPlantStringUnit",
      "type": "object"
    },
    "PvString": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "mppt": {
          "$ref": "#/$defs/Count"
        },
        "input": {
          "$ref": "#/$defs/Count"
        },
        "module_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Module Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "mppt",
        "input",
        "module_ids"
      ],
      "title": "PvString",
      "type": "object"
    },
    "PvStringPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "inverter_product_id": {
          "$ref": "#/$defs/Count"
        },
        "minimum_ambient_c": {
          "anyOf": [
            {
              "minimum": -273.15,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum Ambient C"
        },
        "temperature_source": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature Source"
        },
        "strings": {
          "items": {
            "$ref": "#/$defs/PvString"
          },
          "title": "Strings",
          "type": "array"
        },
        "operating_conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/PvOperatingConditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "inverter_product_id",
        "minimum_ambient_c",
        "temperature_source",
        "strings"
      ],
      "title": "PvStringPlan",
      "type": "object"
    },
    "SchemaVersion": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/PvPlantStringUnit"
      },
      "minItems": 1,
      "title": "Units",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "units"
  ],
  "title": "PvPlantStringPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
