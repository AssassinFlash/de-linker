    }
  ],
  "crawlerType": "cheerio",
  "maxCrawlDepth": 0,
  "maxCrawlPages": 1,
  "saveMarkdown": true,
  "saveText": true,
  "includeUrlGlobs": [],
  "excludeUrlGlobs": [],
  "useSitemaps": false,
  "onlyCrawlPagesModifiedSince": "",
  "useLlmsTxt": false,
  "respectRobotsTxtFile": false,
  "keepUrlFragments": false,
  "ignoreCanonicalUrl": false,
  "proxyConfiguration": {
    "useApifyProxy": true
  },
  "customHttpHeaders": {},
  "signHttpRequests": false,
  "initialConcurrency": 0,
