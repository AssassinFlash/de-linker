node_modules/
vendor/
.venv/
__pycache__/
*.log
.DS_Store
.env
.env.*
!.env.example

# Harness service tokens. C334_EVIDENCE can point inside this tree;
# service-token.txt must stay untracked (campaign #334).
service-token.txt
build/
dist/

# Built apps are committed; `just build::check` keeps them in step with src/.
!plugins/linker-tools/build/
!plugins/linker-commerce/build/

# Test runner output.
.phpunit.result.cache
artifacts/
storybook-static/

# gettext tools leave these beside the catalogue.
*.po~

# Snapshots of the live site stay outside the repository (~/de-linker-data, docs/specs/6-live-pull.md).
*.sql.gz
de-linker-data/
__pycache__/

# .scratch/ is where working material may be committed on purpose (the
# prototype checkouts, capture scripts, evidence), so it is not ignored as a
# whole. Caches are: the FAQ thumbnail pipeline's PDF cache is the live
# uploads (hundreds of MB), and it is rebuilt on demand (tools/faq/thumbs.py
# --cache). Never commit it.
.scratch/faq-pdf-cache/

# The e2e suite's screenshots: per-run evidence of what that run rendered, so
# they belong in the working area and never in a commit (they used to land in
# the acceptance docs and rewrote committed PNGs on every run — ledger H10).
.scratch/e2e-shots/

# Root-level captures and session exports stay outside the repository; ticket
# evidence belongs under docs/acceptance/. A 2026-10-18 sweep committed a
# session transcript, live-site captures and a Playwright admin snapshot.
/*.png
/*.txt
wp-snapshot.yml

# Local tool state never ships (same sweep).
.v2c/
.video_agent/
