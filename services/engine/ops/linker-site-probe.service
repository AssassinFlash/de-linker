[Unit]
Description=Probe WordPress and the local Engine, Planner worker and Genie services
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/linker-engine/ops/site-probe.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# state/site-probe.log and state/site-probe.last are written by the script.
ReadWritePaths=/opt/linker-engine/state
