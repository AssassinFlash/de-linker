# Refreshes state/feed.json and state/compatibility.json from the site's
# engineering feed (#354, #493). The script keeps each previous file on its
# own failure, so a bad night costs nothing; on success it restarts
# linker-engine once (the engine loads both files at start). Hardening
# mirrors the material-registry sync this replaces, plus the paths the new
# script needs: state/ for the atomic swaps, /var/log for the sync log,
# /run/systemd because systemctl restart speaks to the manager's private
# socket.
[Unit]
Description=Refresh the Linker design engine's product feed and compatibility contract
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/linker-engine/ops/sync-feed.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/linker-engine/state /var/log /run/systemd
