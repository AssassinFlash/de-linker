# Refreshes state/feed.json from the site's engineering feed (#354).
# The script keeps the previous feed on any failure, so a bad night costs
# nothing; on success it restarts linker-engine once (the engine loads the
# feed at start). Hardening mirrors the material-registry sync this replaces,
# plus the paths the new script needs: state/ for the atomic swap, /var/log
# for the sync log, /run/systemd because systemctl restart speaks to the
# manager's private socket.
[Unit]
Description=Refresh the Linker design engine's product feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/linker-engine/ops/sync-feed.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/linker-engine/state /var/log /run/systemd
