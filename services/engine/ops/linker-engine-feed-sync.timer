# Nightly run of the feed refresh (#354). 03:40 UTC — clear of the 03:30
# window the old material-registry sync used — with the same randomized
# delay; Persistent catches up after the VPS was down at the scheduled time.
[Unit]
Description=Nightly Linker design engine feed refresh

[Timer]
OnCalendar=*-*-* 03:40:00 UTC
RandomizedDelaySec=10m
Persistent=true
Unit=linker-engine-feed-sync.service

[Install]
WantedBy=timers.target
