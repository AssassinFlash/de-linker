{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://de-linker.com/schemas/engine/feed.schema.json",
	"title": "Engineering feed",
	"description": "What the engine reads from linker-commerce: GET /wp-json/linker/v1/engineering-feed (docs/specs/8-engineering-data.md, target shape 5). One entry per published product. The top-level facts are the #7 SelectionFactSet (docs/specs/7-selection-facts.md), produced by its single implementation in linker-commerce, so the engine never re-derives them; `figures` are the cited datasheet values the engine needs beyond those facts, units as stored (the engine converts by `unit`). A figure without a citation to a document we host does not enter the feed.",
	"type": "object",
	"required": ["schema_version", "generated_at", "source_revision", "compatibility_revision", "compatibility_version", "compatibility", "products", "overlay"],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "const": 1 },
		"figure_projection_version": { "const": 2 },
		"compatibility_origin": { "const": "woocommerce" },
		"source_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"compatibility_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"generated_at": { "type": "string", "format": "date-time" },
		"compatibility_version": {
			"description": "Content version of the required current Woo-maintained compatibility projection; it must match the projection's version.",
			"type": "string",
			"minLength": 1
		},
		"compatibility": {
			"description": "Required current Woo-maintained compatibility declarations and product/document bindings. Consumers validate the projection against compatibility.schema.json and reject a missing projection or a different generation; a shipped JSON file is not a maintenance authority.",
			"type": "object"
		},
		"products": { "type": "array", "items": { "$ref": "#/$defs/product" } },
		"overlay": {
			"description": "Reference engineering inputs generated from current Woo engineering-reference records and bound evidence. The migration JSON is not a runtime authority. Empty while no reference is published and prepared.",
			"type": "array",
			"items": { "$ref": "#/$defs/overlayItem" }
		}
	},
	"$defs": {
		"unknown": { "const": "unknown" },
		"number": { "type": "number", "minimum": 0 },
		"product": {
			"type": "object",
			"required": [
				"id",
				"sku",
				"model",
				"brand",
				"series",
				"device_class",
				"application",
				"phase",
				"ac_power_kw",
				"pv_input_kw",
				"usable_kwh",
				"nominal_kwh",
				"kwh_range",
				"figures",
				"documents"
			],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"canonical_product_id": { "type": "integer", "minimum": 1 },
				"product_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
				"sku": { "type": "string" },
				"model": {
					"description": "pa_model; compatibility patterns are matched against it.",
					"type": "string",
					"minLength": 1
				},
				"brand": { "type": "string" },
				"series": {
					"description": "pa_series (#8 target shape 2); null until assigned.",
					"type": ["string", "null"]
				},
				"device_class": {
					"description": "Slug of the product's primary product category.",
					"type": "string",
					"pattern": "^[a-z0-9-]+$"
				},
				"application": { "enum": ["home", "commercial", "unknown"] },
				"phase": { "oneOf": [{ "enum": [1, 3] }, { "$ref": "#/$defs/unknown" }] },
				"ac_power_kw": { "oneOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/unknown" }] },
				"pv_input_kw": { "oneOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/unknown" }] },
				"usable_kwh": { "oneOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/unknown" }] },
				"nominal_kwh": { "oneOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/unknown" }] },
				"kwh_range": {
					"description": "A stated energy range (for example 57.3-100.3 kWh) that #7 keeps out of the scalars.",
					"oneOf": [
						{ "type": "null" },
						{
							"type": "object",
							"required": ["min", "max"],
							"additionalProperties": false,
							"properties": { "min": { "$ref": "#/$defs/number" }, "max": { "$ref": "#/$defs/number" } }
						}
					]
				},
				"figures": { "$ref": "#/$defs/figures" },
				"package_contents": { "$ref": "#/$defs/packageContents" },
					"installation_facts": { "$ref": "#/$defs/installationFacts" },
				"documents": { "type": "array", "items": { "$ref": "#/$defs/document" } }
			}
		},
		"overlayItem": {
			"type": "object",
			"required": ["id", "kind", "brand", "model", "figures", "documents"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"kind": { "enum": ["pv_module"] },
				"canonical_product_id": { "type": "integer", "minimum": 1 },
				"product_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
				"reference_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
				"brand": { "type": "string" },
				"model": { "type": "string" },
				"figures": { "$ref": "#/$defs/figures" },
				"documents": { "type": "array", "items": { "$ref": "#/$defs/document" } }
			}
		},
		"packageContents": {
			"description": "Cited components supplied with one Woo sales unit. This is not an installation take-off or an independent product list.",
			"type": "object",
			"required": ["status", "items"],
			"additionalProperties": false,
			"properties": {
				"status": { "enum": ["documented", "unresolved"] },
				"items": { "type": "array", "items": { "$ref": "#/$defs/packageItem" } }
			},
			"if": { "properties": { "status": { "const": "unresolved" } } },
			"then": { "properties": { "items": { "maxItems": 0 } } }
		},
		"packageItem": {
			"type": "object",
			"required": ["id", "label", "quantity", "unit", "role", "source"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"label": {
					"type": "object", "required": ["en", "de"], "additionalProperties": false,
					"properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
				},
				"quantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
				"unit": { "enum": ["piece", "pair", "m"] },
				"role": { "enum": ["other", "meter", "backup", "parallel_controller"] },
				"source": {
					"type": "object", "required": ["document_id", "document_revision", "blob_sha256", "product_id", "url", "page"], "additionalProperties": false,
					"properties": {
						"document_id": { "type": "string", "minLength": 1 },
						"document_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
						"blob_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
						"product_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
						"url": { "$ref": "#/$defs/hostedUrl" },
						"page": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
					}
				}
			},
			"if": { "properties": { "unit": { "enum": ["piece", "pair"] } } },
			"then": { "properties": { "quantity": { "type": "integer" } } }
		},
			"installationFacts": {
				"description": "Cited installation obligations and inclusions maintained on the Woo product. Recommended and conditional values remain obligations to assess and never select BOM quantities.",
				"type": "object",
				"required": ["status", "items"],
				"additionalProperties": false,
				"properties": {
					"status": { "enum": ["documented", "unresolved"] },
					"items": { "type": "array", "items": { "$ref": "#/$defs/installationFact" } }
				},
				"if": { "properties": { "status": { "const": "unresolved" } } },
				"then": { "properties": { "items": { "maxItems": 0 } } }
			},
			"installationFact": {
				"type": "object",
				"required": ["id", "handling", "label", "quantity", "unit", "basis", "specification", "conditions", "source"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"handling": { "enum": ["manufacturer_included", "customer_supplied_required", "site_engineering_required"] },
					"label": {
						"type": "object", "required": ["en", "de"], "additionalProperties": false,
						"properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
					},
					"quantity": { "type": ["null", "number"], "exclusiveMinimum": 0, "maximum": 9007199254740991 },
					"unit": { "enum": ["piece", "pair", "m"] },
					"basis": { "type": "string", "minLength": 1 },
					"specification": { "$ref": "#/$defs/installationSpecification" },
					"conditions": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
					"source": { "$ref": "#/$defs/installationSource" }
				},
				"if": { "properties": { "unit": { "enum": ["piece", "pair"] } } },
				"then": { "properties": { "quantity": { "type": ["null", "integer"] } } }
			},
			"installationSpecification": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"terminal_domain": { "enum": ["ac", "pe", "battery_dc", "pv_dc", "communication"] },
					"terminals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
					"recommended_conductor_mm2": { "$ref": "#/$defs/recommendedInterval" },
					"cable_od_mm": { "$ref": "#/$defs/recommendedInterval" },
					"minimum_voltage_v": { "type": "number", "exclusiveMinimum": 0 },
					"minimum_current_a": { "type": "number", "exclusiveMinimum": 0 },
					"rating_note": { "type": "string" }
				}
			},
			"recommendedInterval": {
				"description": "A manufacturer's recommended range. The high value is not renamed as a maximum and does not select a cable or protection device.",
				"type": "object",
				"required": ["low", "high"],
				"additionalProperties": false,
				"properties": {
					"low": { "type": "number", "exclusiveMinimum": 0 },
					"high": { "type": "number", "exclusiveMinimum": 0 }
				}
			},
			"installationSource": {
				"type": "object",
				"required": ["document_id", "document_revision", "blob_sha256", "product_id", "url", "page", "quote"],
				"additionalProperties": false,
				"properties": {
					"document_id": { "type": "string", "minLength": 1 },
					"document_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
					"blob_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
					"product_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
					"url": { "$ref": "#/$defs/hostedUrl" },
					"page": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
					"quote": { "type": "string", "minLength": 1, "maxLength": 2000 }
				}
			},
			"localizedText": {
				"type": "object",
				"required": ["en", "de"],
				"additionalProperties": false,
				"properties": {
					"en": { "type": "string", "minLength": 1 },
					"de": { "type": "string", "minLength": 1 }
				}
			},
		"figures": {
			"description": "Figure key -> cited value. Keys the engine reads are listed in docs/specs/8-engineering-data.md target shape 1.",
			"type": "object",
			"propertyNames": { "pattern": "^[a-z0-9_]+$" },
			"additionalProperties": { "$ref": "#/$defs/figure" }
		},
		"figure": {
			"type": "object",
			"required": ["value", "unit", "citation"],
			"additionalProperties": false,
			"properties": {
				"value": { "type": ["string", "number"] },
				"value_de": { "type": "string" },
				"qualifier": {
					"description": "The condition as maintained in Woo. It is evidence to interpret, never an automatically satisfied engineering predicate.",
					"type": ["string", "object", "array", "null"]
				},
				"evidence_refs": { "type": "array", "items": { "type": "string" } },
				"columns": {
					"description": "Explicit table column labels maintained with the Woo figure. Column order or model names alone never establishes a configuration mapping.",
					"type": "array",
					"items": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number"] } }
				},
				"unit": { "type": ["string", "null"] },
				"citation": { "$ref": "#/$defs/citation" }
			}
		},
		"citation": {
			"type": "object",
			"required": ["url"],
			"additionalProperties": false,
			"properties": {
				"url": { "$ref": "#/$defs/hostedUrl" },
				"doc": { "type": "string", "description": "Original source-document label, retained as provenance. Permission requires the cited hosted URL and current Woo evidence; the label does not authorize use." },
				"page": { "type": "integer", "minimum": 1 }
			}
		},
		"document": {
			"type": "object",
			"required": ["url", "title", "type", "lang"],
			"additionalProperties": false,
			"properties": {
				"role": { "type": "string" },
				"aliases": { "type": "array", "items": { "$ref": "#/$defs/hostedUrl" }, "description": "Explicit hosted aliases of this versioned document, still subject to current source-product permission." },
				"citation_aliases": { "type": "array", "items": { "type": "string" } },
				"document_id": { "type": "string" },
				"document_revision": { "type": "string" },
				"blob_sha256": { "type": "string" },
				"product_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
				"url": { "$ref": "#/$defs/hostedUrl" },
				"title": { "type": "string" },
				"type": { "type": "string" },
				"lang": { "type": "string", "pattern": "^(?:[a-z]{2}|mul|und)$", "description": "Producer-normalized language: a lowercase two-letter language, mul for explicitly multilingual material, und when unstated or unrecognized. Woo's editorial value remains unchanged; unknown does not imply English or German." }
			}
		},
		"hostedUrl": {
			"description": "Every document is a file we host (owner ruling 2026-09-02).",
			"type": "string",
			"pattern": "^https://de-linker\\.com/"
		}
	}
}
