# LF everywhere, so build/manifest.json hashes the same bytes on every machine.
* text=auto eol=lf

# Preserve exact generated/downloaded PDF bytes and keep them out of text diffs.
*.pdf binary

# Generated files: collapsed in pull request diffs.
plugins/linker-tools/build/** linguist-generated=true
**/composer.lock linguist-generated=true
**/package-lock.json linguist-generated=true
**/uv.lock linguist-generated=true

# Exact official-page excerpts retain source whitespace and their recorded hashes.
docs/research/2026-10-24-pv-managed-intake/raw/docs-*-excerpt.txt -whitespace

# Preserve the browser's exact CSV download bytes, including CRLF.
docs/acceptance/2026-10-25/548/trace-ui/de-intervals-1-100.csv -text
